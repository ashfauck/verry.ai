# Production Environment Configuration
NODE_ENV=production

# API Configuration
API_BASE_URL=https://api.verry.ai/functions
API_VERSION=v1
API_TIMEOUT=15000

# Document Scanner Configuration
DOCUMENT_SCANNER_QUALITY=100
DOCUMENT_SCANNER_MAX_DOCUMENTS=1

# Face Verification Configuration
FACE_DETECTION_CONFIDENCE=0.85
FACE_CAPTURE_TIMEOUT=20000

# Theme Configuration
DEFAULT_THEME=light

# Debug Configuration
DEBUG_MODE=false
LOG_LEVEL=error
ENABLE_FLIPPER=false

# Camera Configuration
CAMERA_QUALITY=high
CAMERA_FLASH_MODE=auto

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_API_KEY=prod_analytics_key

# Error Reporting
ERROR_REPORTING_ENABLED=true
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Security
CERTIFICATE_PINNING=true
SSL_VERIFY=true

# Verry.ai API Credentials
VERRY_API_KEY=ak_7de890fa1b8649dbb7b3d554
VERRY_CLIENT_ID=cli_4mtqfircysno