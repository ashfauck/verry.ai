# Local Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

NODE_ENV=development

# API Configuration
API_BASE_URL=http://localhost:3000
API_VERSION=v1
API_TIMEOUT=30000

# Document Scanner Configuration
DOCUMENT_SCANNER_QUALITY=80
DOCUMENT_SCANNER_MAX_DOCUMENTS=1

# Face Verification Configuration
FACE_DETECTION_CONFIDENCE=0.7
FACE_CAPTURE_TIMEOUT=45000

# Theme Configuration
DEFAULT_THEME=light

# Debug Configuration
DEBUG_MODE=true
LOG_LEVEL=debug
ENABLE_FLIPPER=true

# Metro Configuration
METRO_PORT=8081

# Camera Configuration
CAMERA_QUALITY=medium
CAMERA_FLASH_MODE=off

# Analytics (for local testing)
ANALYTICS_ENABLED=false
ANALYTICS_API_KEY=local_test_key

# Error Reporting (disabled for local)
ERROR_REPORTING_ENABLED=false
SENTRY_DSN=

# Verry.ai API Credentials
VERRY_API_KEY=ak_7de890fa1b8649dbb7b3d554
VERRY_CLIENT_ID=cli_4mtqfircysno