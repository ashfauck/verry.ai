{
  "name": "verry-app",
  "ve    \"env:setup\": \"./scripts/clean-environment.sh && ./scripts/install-dependencies.sh\",\n    \"env:diagnose\": \"./scripts/diagnose-metro.sh\",sion": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "ENVFILE=.env.development react-native run-android --mode=developmentDebug",
    "android:staging": "ENVFILE=.env.staging react-native run-android --mode=stagingDebug",
    "android:prod": "ENVFILE=.env.production react-native run-android --mode=productionRelease",
    "ios": "react-native run-ios",
    "ios:dev": "ENVFILE=.env.development react-native run-ios --scheme=VerryAppDevelopment",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios --scheme=VerryAppStaging",
    "ios:prod": "ENVFILE=.env.production react-native run-ios --scheme=VerryAppProduction",
    "lint": "eslint .",
    "start": "npx react-native start --reset-cache",
    "start:rn": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "start:dev": "ENVFILE=.env.development react-native start --reset-cache --port 8081",
    "start:expo": "npx expo start --dev-client --clear",
    "start:metro-direct": "node_modules/.bin/metro serve --port 8081 --max-workers 1",
    "start:pure": "node scripts/start-metro-pure.js",
    "start:pure-reset": "node scripts/start-metro-pure.js --reset-cache",
    "start:prod": "ENVFILE=.env.production react-native start --port 8081",
    "test": "jest",
    "clean": "npm run clean:metro && npm run clean:ios && npm run clean:android",
    "clean:metro": "rm -rf /tmp/metro-* /tmp/react-* ~/.metro /tmp/haste-map-* || true",
    "clean:ios": "rm -rf ios/build ios/Pods ios/VerryApp.xcworkspace/xcuserdata ios/VerryApp.xcodeproj/xcuserdata || true",
    "clean:android": "rm -rf android/build android/app/build android/.gradle || true",
    "clean:node": "rm -rf node_modules && npm install",
    "clean:deep": "npm run clean && npm run clean:node",
    "pod-install": "cd ios && pod install",
    "pod-install-clean": "cd ios && rm -rf Pods && pod install",
    "_postinstall_disabled": "cd ios && pod install",
    "metro:debug": "react-native start --verbose",
    "metro:reset": "react-native start --reset-cache --verbose",
    "env:setup": "./scripts/clean-environment.sh && ./scripts/install-dependencies.sh",
    "env:diagnose": "./scripts/diagnose-metro.sh",
    "ios:clean": "npm run clean:ios && npm run pod-install-clean",
    "debug:metro": "DEBUG=metro* react-native start",
    "_postinstall_disabled2": "cd ios && pod install --repo-update"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/image-editor": "^4.2.0",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.3.29",
    "react": "18.2.0",
    "react-native": "0.74.7",
    "react-native-config": "^1.5.1",
    "react-native-device-info": "^10.13.0",
    "react-native-document-scanner-plugin": "1.0.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-screens": "~3.31.1",
    "react-native-svg": "^15.2.0",
    "react-native-vision-camera": "^4.0.0",
    "recoil": "^0.7.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "^20.0.2",
    "@react-native-community/cli-platform-ios": "13.6.9",
    "@react-native/babel-preset": "0.74.89",
    "@react-native/eslint-config": "0.74.89",
    "@react-native/metro-config": "0.74.89",
    "@react-native/typescript-config": "0.74.89",
    "@tsconfig/react-native": "^3.0.5",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.19.0",
    "ip": "^2.0.1",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "packageManager": "npm@10.9.0",
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
