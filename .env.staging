# Staging Environment Configuration
APP_ENV=staging
APP_NAME=Verry Staging
APP_VERSION=1.0.0-staging

# API Configuration
API_BASE_URL=https://api.verry.ai/functions
API_VERSION=v1
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3

# Feature Flags
ENABLE_DEBUG_MODE=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_PUSH_NOTIFICATIONS=true

# Document Scanner Configuration
DOCUMENT_QUALITY=high
DOCUMENT_AUTO_CAPTURE=true
DOCUMENT_MAX_RETRIES=3

# Logging Configuration
LOG_LEVEL=debug
ENABLE_CONSOLE_LOGS=true
ENABLE_FILE_LOGS=true
ENABLE_REMOTE_LOGS=true

# Build Configuration
BUILD_TYPE=staging
BUNDLE_ID_SUFFIX=.staging

# Verry.ai API Credentials
VERRY_API_KEY=ak_7de890fa1b8649dbb7b3d554
VERRY_CLIENT_ID=cli_4mtqfircysno