//
// Staging.xcconfig
// Configuration for Staging environment
//

// Include Pods Debug configuration
#include "Pods/Target Support Files/Pods-VerryApp/Pods-VerryApp.debug.xcconfig"

// App Display Name
DISPLAY_NAME = VerryApp Staging

// Bundle Identifier
PRODUCT_BUNDLE_IDENTIFIER = $(inherited).staging

// Other staging-specific settings
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) STAGING=1