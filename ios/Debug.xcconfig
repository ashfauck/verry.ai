//
// Debug.xcconfig
// Environment-specific settings for Debug
//

#include "Pods/Target Support Files/Pods-VerryApp/Pods-VerryApp.debug.xcconfig"

// Debug Configuration
APP_DISPLAY_NAME = VerryApp Debug
BUNDLE_ID_PREFIX = com.appnoize
BUNDLE_ID_SUFFIX = .verry.ai
CODE_SIGN_ENTITLEMENTS = VerryApp/VerryApp-Production.entitlements
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEBUG=1 PRODUCTION=1