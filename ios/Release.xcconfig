//
// Production.xcconfig
// Environment-specific settings for Production
//

// Include base Pods configuration
#include "Pods/Target Support Files/Pods-VerryApp/Pods-VerryApp.release.xcconfig"

// Production Release Configuration
APP_DISPLAY_NAME = VerryApp
BUNDLE_ID_PREFIX = com.appnoize
BUNDLE_ID_SUFFIX = .verry.ai
CODE_SIGN_ENTITLEMENTS = VerryApp/VerryApp-Production.entitlements
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) PRODUCTION=1
