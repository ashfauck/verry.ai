require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

platform :ios, '13.4'
prepare_react_native_project!

target 'VerryApp' do
  # Add custom build configurations for Dev, QA, and Production
  project 'VerryApp', {
    'Dev.Debug' => :debug,
    'Dev.Release' => :release,
    'QA.Debug' => :debug,
    'QA.Release' => :release,
    'Release' => :release,
    'Debug' => :debug
  }

  use_react_native!(
    :path => '../node_modules/react-native',
    :hermes_enabled => true,
    :fabric_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  use_native_modules!

  target 'VerryAppTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # Fix React-Codegen and React Native CLI script issues
    react_native_post_install(
      installer,
      '../node_modules/react-native',
      :mac_catalyst_enabled => false
    )
    
    # Fix React-Codegen script execution environment
    installer.pods_project.targets.each do |target|
      if target.name.include?('React-Codegen') || target.name.include?('React-rncore')
        target.build_phases.each do |build_phase|
          if build_phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
            # Ensure proper environment for React-Codegen scripts
            build_phase.shell_script = "#!/bin/bash\nset -e\nexport NODE_BINARY=\"$(command -v node)\"\nexport PATH=\"$PATH:./node_modules/.bin\"\n" + build_phase.shell_script
          end
        end
      end
    end

    # Apple Silicon and stability optimizations
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Set minimum iOS deployment target
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.4'

        # Apple Silicon optimizations
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'

        # Fix glog build issues on Apple Silicon
        if target.name.include?('glog')
          config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
          config.build_settings['CLANG_WARN_EVERYTHING'] = 'NO'
          config.build_settings['OTHER_CFLAGS'] = '-DGOOGLE_GLOG_IS_A_DLL=0'
        end

        # Fix Flipper compatibility issues
        if target.name.start_with?('Flipper')
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end

        # Fix Hermes engine build issues
        if target.name.include?('hermes')
          config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
          config.build_settings['CLANG_WARN_EVERYTHING'] = 'NO'
          config.build_settings['CLANG_WARN_UNREACHABLE_CODE'] = 'NO'
          config.build_settings['CLANG_WARN_STRICT_PROTOTYPES'] = 'NO'
          config.build_settings['CLANG_WARN_COMMA'] = 'NO'
          config.build_settings['GCC_WARN_64_TO_32_BIT_CONVERSION'] = 'NO'
          config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
          config.build_settings['CLANG_WARN_DOCUMENTATION_COMMENTS'] = 'NO'
          config.build_settings['CLANG_WARN_SUSPICIOUS_MOVE'] = 'NO'
          config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
          config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
          # Fix code signing issues that can cause script phase failures
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
          config.build_settings['CODE_SIGN_IDENTITY'] = ''
          config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ''
        end

        # Additional Hermes-specific fixes for script phase execution
        if target.name == 'hermes-engine'
          config.build_settings['ENABLE_BITCODE'] = 'NO'
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '-DFOLLY_NO_CONFIG -DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1 -Wno-comma -Wno-shorten-64-to-32'
          config.build_settings['HEADER_SEARCH_PATHS'] = '$(inherited) "${PODS_ROOT}/RCT-Folly"'
        end

        # Fix React-Codegen build issues
        if target.name.include?('React-Codegen') || target.name.include?('React-rncore')
          config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
          config.build_settings['CLANG_WARN_EVERYTHING'] = 'NO'
          config.build_settings['OTHER_CFLAGS'] = '$(inherited) -Wno-error'
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -Wno-error'
        end

        # Ensure all targets use the same deployment target
        config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '10.14'
      end
    end
  end
end