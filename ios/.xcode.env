# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
# Set explicit path to avoid NVM version mismatches
export NODE_BINARY="/Users/ashfauck/.nvm/versions/node/v20.18.0/bin/node"

# Add node_modules/.bin to PATH for React Native CLI tools
export PATH="/Users/ashfauck/.nvm/versions/node/v20.18.0/bin:$PATH:./node_modules/.bin:../node_modules/.bin"

# React Native and Codegen configuration
export RN_CLI="../node_modules/.bin/react-native"
export RN_VERSION=0.74.7

# React-Codegen specific configuration - Use absolute paths to avoid confusion
export REACT_NATIVE_PATH="/Users/ashfauck/Development/Projects/Personal/Verry.ai/node_modules/react-native"
export PODS_ROOT="/Users/ashfauck/Development/Projects/Personal/Verry.ai/ios/Pods"
export PODS_TARGET_SRCROOT="/Users/ashfauck/Development/Projects/Personal/Verry.ai"

# Disable Hermes engine (consistent with Podfile configuration)
export USE_HERMES=0

# Architecture and build configuration
export ARCHS_STANDARD="arm64 x86_64"
export DISABLE_FLIPPER=1

# Shell and script execution environment
export SHELL=/bin/bash
export SCRIPT_PHASE_ALLOW_NETWORK=1

# Fix script execution permissions and logging
export VERBOSE=1
export CI=false
